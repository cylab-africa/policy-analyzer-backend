# Copy to .env. Keep comments on their own lines: Docker's env_file does not strip inline comments.

# Key clients send in the X-API-Key header. Use the same value as BACKEND_API_KEY in the frontend.
API_KEY=change-me-to-a-long-random-string

# Serves /api/docs and /openapi.json without an API key. Off by default; uncomment on your own
# machine for local development only, never in production.
# ENABLE_API_DOCS=true

# Password for Redis (Docker Compose starts Redis with it). Set a long random value in production.
# REDIS_PASSWORD=change-me-too

# Browser origins allowed to call this API directly (comma-separated). Leave empty: the website
# calls the API from its own server, so no browser needs direct access.
# CORS_ALLOWED_ORIGINS=

# Folder the folder-process route may read from. The route is switched off while this is unset.
# INGEST_FOLDER_ROOT=/data/ingest

# Rate limits per client (0 = no limit). Counted in Redis, so they hold across workers and
# restarts; set RATE_LIMIT_STORE=memory to count in each process instead.
# QUERY_RATE_LIMIT_PER_MINUTE=20
# BATCH_UPLOAD_RATE_LIMIT_PER_HOUR=10
# Document uploads (each may hold up to 10 files)
# UPLOAD_RATE_LIMIT_PER_HOUR=10
# RATE_LIMIT_STORE=redis

# The website's server as this API sees it: exact addresses or hostnames, comma-separated. When
# the website runs in Docker on the same network as the backend, use its container name (for
# example pdp-frontend): it is looked up again every 30 seconds, so it keeps working when the
# container is recreated with a new address. Only requests from these may name the visitor in the
# X-Client-IP header. Ranges such as 172.18.0.0/16 are refused: they include the network's gateway,
# which is where Docker forwards some outside connections from. While this is empty, every visitor
# of the website shares one limit, and the log says so the first time the website calls.
# TRUSTED_PROXY_IPS=

# Operator key (X-Admin-Key header) for the /api/admin routes, listing all batch jobs, deleting any
# job, and creating, changing or deleting the country reference data under /api/info. Use a long
# random value (openssl rand -hex 32) different from API_KEY, and never give it to the website.
# While it is unset, those operations are switched off.
# ADMIN_API_KEY=

# OpenAI key, or the key of your OpenAI-compatible gateway
OPENAI_API_KEY=sk-your-openai-key

# Address of an OpenAI-compatible gateway such as LiteLLM. Leave unset to call OpenAI directly.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1

# MongoDB address. With the bundled MongoDB (--profile local-db) and the login below, use
# mongodb://pdp:YOUR_MONGO_ROOT_PASSWORD@mongo:27017/?authSource=admin
MONGODB_CONNECTION_STRING=mongodb://localhost:27017

# Login for the bundled MongoDB (--profile local-db). Set both, or neither (no login: local use only).
# Use a password with letters and digits only (for example: openssl rand -hex 24), because it goes
# into the connection string above. It only takes effect the first time the data volume is created.
# MONGO_ROOT_USERNAME=pdp
# MONGO_ROOT_PASSWORD=

# MongoDB database name
MONGODB_DATABASE_NAME=policy_analyzer_db

# Language model provider
MODEL_PROVIDER=openai

# Model used to detect countries in a question. Answer models are set per task in config/llm_providers.json;
# run scripts/use_openai_models.py to switch those to OpenAI.
OPENAI_MODEL=gpt-4o

# Embedding model name. If you change it, upload your documents again.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store: qdrant (default) or mongodb for Atlas Vector Search (experimental)
VECTOR_STORE=qdrant

# Qdrant address. Docker Compose sets this for you.
QDRANT_HOST=http://localhost:6333

# Topic areas. Must match config/application.json.
supported_tabs=data-protection,digital-id

# Web search used when few documents match a question (https://tavily.com)
# TAVILY_API_KEY=tvly-your-key

# false saves uploads on disk, true stores them in Amazon S3 (the code default is true)
USE_S3=false

# Largest upload in bytes (default 10485760, which is 10 MB)
# MAX_FILE_SIZE=10485760

# Comma-separated MIME types accepted for upload. The default is every document type the app can
# read: PDF, plain text, Markdown and Word (.docx; the old .doc format cannot be read). An upload's
# type is taken from its file extension, because browsers disagree on what they send for some files
# (Markdown, for one).
# ALLOWED_FILE_TYPES=application/pdf,text/plain,text/markdown,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# S3 access key, needed when USE_S3=true
# AWS_ACCESS_KEY_ID=

# S3 secret key, needed when USE_S3=true
# AWS_SECRET_ACCESS_KEY=

# S3 region
# AWS_REGION=us-east-1

# S3 bucket name
# S3_BUCKET_NAME=

# Not needed for AWS S3, boto3 uses the default endpoints. For a custom S3-compatible service, set it here.
# S3_ENDPOINT=

# Email server used to notify users when a batch report is ready
# SMTP_SERVER=smtp.gmail.com

# Email server port
# SMTP_PORT=587

# Email account the reports are sent from
# SMTP_USERNAME=you@example.com

# Password or app password for that account
# SMTP_PASSWORD=your-app-password

# Address shown as the sender. Leave unset to use SMTP_USERNAME; any other address must be set up
# as an alias of that account, or the mail server may reject the email.
# SENDER_EMAIL=you@example.com

# Name shown as the sender (default: PDP Africa Analyzer)
# SENDER_NAME=PDP Africa Analyzer

# Hugging Face token, only if model downloads are rate-limited
# HF_TOKEN=

# LangSmith tracing. Sends prompts and retrieved documents to LangSmith, so leave it unset unless you want that.
# LANGSMITH_API_KEY=

# Not read by this version. The code uses UPLOAD_EXPIRATION, in seconds.
# UPLOAD_EXPIRATION_TIME=

# Not read by this version. The code uses DOWNLOAD_EXPIRATION, in seconds.
# DOWNLOAD_EXPIRATION_TIME=

# Not read by this version. Belongs to an older MongoDB vector setup.
# MONGODB_INDEX_NAME_DIGITAL_ID=

# Not read by this version. Belongs to an older MongoDB vector setup.
# MONGODB_COLLECTION_NAME_DATA_PROTECTION=

# Not read by this version. Belongs to an older MongoDB vector setup.
# MONGODB_INDEX_NAME_DATA_PROTECTION=
